<% var siteUrl=typeof baseUrl !=='undefined' ? baseUrl : 'https://munchtimecafe.com.np' ; var previewMode=(typeof
  isPreview !=='undefined' && isPreview); var blogData=(typeof blog !=='undefined' && blog) ? blog : {}; var
  postUrl=previewMode ? '#preview' : siteUrl + '/blog/' + (blogData.slug || '' ) + '.html' ; var imgSrc='' ; if
  (blogData.blog_img_filename) { imgSrc=previewMode ? (blogData.featured_image_data ? '/uploads/' +
  blogData.featured_image_data.filename : '' ) : '../blog-img/' + blogData.blog_img_filename; } else if
  (blogData.featured_image_data) { imgSrc='/uploads/' + blogData.featured_image_data.filename; } var authorImgSrc='' ;
  if (blogData.author_image_data) { authorImgSrc='/uploads/' + blogData.author_image_data.filename; } var descText='' ;
  if (blogData.excerpt) { descText=blogData.excerpt; } else if (blogData.content_html) { descText=blogData.content_html
  .replace(/<[^>]*>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 160);
  }

  var vidId = typeof youtubeId !== 'undefined' ? youtubeId : null;

  if (!vidId && blogData.youtube_url) {
  var ytMatch = blogData.youtube_url.match(/(?:v=|youtu\.be\/|embed\/)([^&?/]+)/);
  if (ytMatch) vidId = ytMatch[1];
  }

  var pubDateFmt = '';

  if (blogData.published_at) {
  if (typeof formatDate === 'function') {
  pubDateFmt = formatDate(blogData.published_at);
  } else {
  pubDateFmt = blogData.published_at;
  }
  }

  var canonicalUrl = siteUrl + '/blog/' + (blogData.slug || '') + '.html';

  var schemaImg = imgSrc
  ? (imgSrc.startsWith('http')
  ? imgSrc
  : siteUrl + '/' + imgSrc.replace(/^\.\.\//, '')) : '';
  %>
  <!DOCTYPE html>
  <html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>
      <%= blog.title %> | Munch Time Cafe
    </title>
    <meta name="description" content="<%= descText %>">
    <link rel="canonical" href="<%= canonicalUrl %>">
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= blog.title %>">
    <meta property="og:description" content="<%= descText %>">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <% if(imgSrc){ %>
      <meta property="og:image" content="<%= schemaImg %>">
      <% } %>
        <meta property="og:site_name" content="Munch Time Cafe">
        <% if(blog.published_at){ %>
          <meta property="article:published_time" content="<%= blog.published_at %>">
          <% } %>
            <% if(blog.topic){ %>
              <meta property="article:section" content="<%= blog.topic %>">
              <% } %>
                <meta name="twitter:card" content="summary_large_image">
                <meta name="twitter:title" content="<%= blog.title %>">
                <meta name="twitter:description" content="<%= descText %>">
                <% if(imgSrc){ %>
                  <meta name="twitter:image" content="<%= schemaImg %>">
                  <% } %>
                    <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "<%= blog.title.replace(/"/g, '\\"') %>",
    "description": "<%= descText.replace(/"/g, '\\"') %>",
    <% if(imgSrc){ %>"image": "<%= schemaImg %>",<% } %>
    "datePublished": "<%= blog.published_at || '' %>",
    "dateModified": "<%= blog.updated_at || blog.published_at || '' %>",
    <% if(blog.author_name){ %>
    "author": {
      "@type": "Person",
      "name": "<%= blog.author_name.replace(/"/g, '\\"') %>"
    },
    <% } %>
    "publisher": {
      "@type": "Organization",
      "name": "Munch Time Cafe",
      "url": "<%= siteUrl %>"
    },
    "url": "<%= canonicalUrl %>"
  }
  </script>
                    <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "<%= siteUrl %>/index.html" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "<%= siteUrl %>/blog.html" },
      { "@type": "ListItem", "position": 3, "name": "<%= blog.title.replace(/"/g, '\\"') %>", "item": "<%= canonicalUrl %>" }
    ]
  }
  </script>
                    <style>
                      :root{--brand:#c1440e;--brand-dark:#a03a0c;--text:#2c2c2c;--muted:#777;--bg:#f7f5f3;--white:#fff;--radius:8px}
                      *{box-sizing:border-box;margin:0;padding:0}
                      body{font-family:'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--text);font-size:15px;line-height:1.7}
                      a{color:var(--brand);text-decoration:none}
                      a:hover{text-decoration:underline}
                      img{max-width:100%;height:auto}
                      .site-header{background:var(--brand);color:#fff;padding:14px 20px;display:flex;align-items:center;gap:16px}
                      .site-header .logo{font-size:20px;font-weight:bold;color:#fff;text-decoration:none}
                      .site-header .logo span{font-size:13px;opacity:.8;margin-left:4px}
                      .site-header nav{margin-left:auto;display:flex;gap:16px}
                      .site-header nav a{color:#fff;opacity:.85;font-size:13px}
                      .site-header nav a:hover{opacity:1;text-decoration:none}
                      .breadcrumb{background:#fff;border-bottom:1px solid #ece9e5;padding:10px 20px;font-size:12px;color:var(--muted)}
                      .breadcrumb a{color:var(--muted)}
                      .breadcrumb a:hover{color:var(--brand)}
                      .breadcrumb span{margin:0 6px}
                      .page-wrap{max-width:1100px;margin:0 auto;padding:28px 20px;display:grid;grid-template-columns:1fr 300px;gap:32px}
                      @media(max-width:768px){.page-wrap{grid-template-columns:1fr}}
                      .article-meta{margin-bottom:20px}
                      .topic-badge{display:inline-block;background:var(--brand);color:#fff;font-size:11px;font-weight:bold;padding:3px 10px;border-radius:12px;margin-bottom:10px;text-transform:uppercase;letter-spacing:.5px}
                      .article-title{font-size:28px;font-weight:bold;line-height:1.3;margin-bottom:12px;color:#1a1a1a}
                      .article-date{font-size:12px;color:var(--muted)}
                      .feat-img{width:100%;max-height:440px;object-fit:cover;border-radius:var(--radius);margin-bottom:28px;display:block}
                      .article-body{font-size:15px;line-height:1.8;color:var(--text)}
                      .article-body h2{font-size:20px;margin:28px 0 12px;color:#1a1a1a}
                      .article-body h3{font-size:17px;margin:22px 0 10px;color:#333}
                      .article-body p{margin-bottom:16px}
                      .article-body ul,.article-body ol{margin:12px 0 16px 22px}
                      .article-body li{margin-bottom:6px}
                      .article-body img{border-radius:6px;margin:12px 0}
                      .article-body blockquote{border-left:4px solid var(--brand);padding:10px 16px;background:#fff8f5;margin:16px 0;font-style:italic;border-radius:0 6px 6px 0}
                      .article-body pre,.article-body code{background:#f5f5f5;border-radius:4px;font-family:monospace;font-size:13px}
                      .article-body pre{padding:12px;overflow-x:auto;margin:12px 0}
                      .article-body code{padding:1px 5px}
                      .article-body table{width:100%;border-collapse:collapse;margin:16px 0}
                      .article-body th{background:#f0f0f0;padding:8px;text-align:left;font-size:13px;border:1px solid #e0e0e0}
                      .article-body td{padding:8px;border:1px solid #e0e0e0;font-size:13px}
                      .yt-section{margin:28px 0}
                      .yt-section h3{font-size:16px;margin-bottom:12px;color:#333}
                      .yt-wrap{position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:var(--radius)}
                      .yt-wrap iframe{position:absolute;top:0;left:0;width:100%;height:100%;border:0}
                      .comment-section{margin:32px 0;padding:20px;background:#fff;border-radius:var(--radius);border-left:4px solid var(--brand);box-shadow:0 1px 4px rgba(0,0,0,.06)}
                      .comment-section h3{font-size:15px;margin-bottom:10px;color:#333}
                      .comment-section p{font-size:14px;color:#555;line-height:1.7}
                      .author-section{display:flex;align-items:center;gap:14px;margin:32px 0;padding:18px;background:#fff;border-radius:var(--radius);box-shadow:0 1px 4px rgba(0,0,0,.06)}
                      .author-img{width:56px;height:56px;border-radius:50%;object-fit:cover;flex-shrink:0;background:#eee}
                      .author-img-placeholder{width:56px;height:56px;border-radius:50%;background:var(--brand);color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:bold;flex-shrink:0}
                      .author-info h4{font-size:14px;font-weight:bold;margin-bottom:3px}
                      .author-info span{font-size:12px;color:var(--muted)}
                      .back-link{display:inline-block;margin-top:28px;font-size:13px;color:var(--muted)}
                      .back-link:hover{color:var(--brand)}
                      .sidebar-card{background:#fff;border-radius:var(--radius);box-shadow:0 1px 4px rgba(0,0,0,.06);padding:18px;margin-bottom:20px}
                      .sidebar-card h3{font-size:14px;font-weight:bold;margin-bottom:14px;padding-bottom:8px;border-bottom:2px solid var(--brand);color:#333}
                      .recent-item{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid #f0f0f0}
                      .recent-item:last-child{border-bottom:none}
                      .recent-thumb{width:52px;height:40px;object-fit:cover;border-radius:4px;flex-shrink:0;background:#eee}
                      .recent-thumb-empty{width:52px;height:40px;border-radius:4px;background:#f0f0f0;flex-shrink:0}
                      .recent-info a{font-size:12px;font-weight:bold;color:#333;line-height:1.4;display:block}
                      .recent-info a:hover{color:var(--brand)}
                      .recent-info span{font-size:11px;color:var(--muted)}
                      .preview-banner{background:#fff3cd;border:1px solid #ffc107;color:#856404;padding:10px 16px;font-size:13px;text-align:center;font-weight:bold}
                      .site-footer{background:#1a1a1a;color:#aaa;text-align:center;padding:20px;font-size:12px;margin-top:40px}
                      .site-footer a{color:#c1440e}
                    </style>
  </head>

  <body>

    <% if(isPreview){ %>
      <div class="preview-banner">⚠ Preview Mode — This post has not been generated yet. Save and generate to publish.</div>
      <% } %>

        <header class="site-header">
          <a href="../index.html" class="logo">Munch Time<span>Cafe</span></a>
          <nav>
            <a href="../index.html">Home</a>
            <a href="../menu.html">Menu</a>
            <a href="../blog.html">Blog</a>
          </nav>
        </header>

        <div class="breadcrumb">
          <a href="../index.html">Home</a>
          <span>›</span>
          <a href="../blog.html">Blog</a>
          <span>›</span>
          <%= blog.title %>
        </div>

        <div class="page-wrap">
          <main class="article-wrap">
            <div class="article-meta">
              <% if(blog.topic){ %>
                <span class="topic-badge"><%= blog.topic %></span>
                <% } %>
                  <h1 class="article-title"><%= blog.title %></h1>
                  <% if(pubDateFmt){ %>
                    <span class="article-date">Published <%= pubDateFmt %></span>
                    <% } %>
            </div>

            <% if(imgSrc){ %>
              <img class="feat-img" src="<%= imgSrc %>" alt="<%= blog.featured_image_data ? (blog.featured_image_data.alt_text || blog.title) : blog.title %>">
              <% } %>

                <div class="article-body">
                  <%- blog.content_html || '<p>No content yet.</p>' %>
                </div>

                <% if(vidId){ %>
                  <div class="yt-section">
                    <h3>Watch Video</h3>
                    <div class="yt-wrap">
                      <iframe src="https://www.youtube.com/embed/<%= vidId %>" title="<%= blog.title %>" allowfullscreen loading="lazy"></iframe>
                    </div>
                  </div>
                  <% } %>

                    <% if(blog.author_name){ %>
                      <div class="author-section">
                        <% if(authorImgSrc){ %>
                          <img class="author-img" src="<%= authorImgSrc %>" alt="<%= blog.author_name %>">
                          <% } else { %>
                            <div class="author-img-placeholder"><%= blog.author_name.charAt(0).toUpperCase() %></div>
                            <% } %>
                              <div class="author-info">
                                <h4><%= blog.author_name %></h4>
                                <span>Munch Time Cafe, Chitwan</span>
                              </div>
                      </div>
                      <% } %>

                        <% if(blog.comment_text){ %>
                          <div class="comment-section">
                            <h3>A Note from Our Kitchen</h3>
                            <p><%= blog.comment_text %></p>
                          </div>
                          <% } %>

                            <a href="../blog.html" class="back-link">← Back to all posts</a>
          </main>

          <aside class="sidebar">
            <div class="sidebar-card">
              <h3>Recent Posts</h3>
              <% if(recentBlogs && recentBlogs.length){ %>
                <% recentBlogs.forEach(function(r){ %>
                  <% var rHref=isPreview ? '/blogs/' + r.id + '/preview' : r.slug + '.html' ; var rThumb=r.featured_image_data ? '/uploads/' + r.featured_image_data.filename : '' ; %>
                    <div class="recent-item">
                      <% if(rThumb){ %>
                        <img class="recent-thumb" src="<%= rThumb %>" alt="<%= r.title %>">
                        <% } else { %>
                          <div class="recent-thumb-empty"></div>
                          <% } %>
                            <div class="recent-info">
                              <a href="<%= rHref %>"><%= r.title %></a>
                              <span><%= r.published_at ? new Date(r.published_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '' %></span>
                            </div>
                    </div>
                    <% }) %>
                      <% } else { %>
                        <p style="font-size:12px;color:#aaa">No published posts yet.</p>
                        <% } %>
            </div>

            <div class="sidebar-card">
              <h3>Visit Us</h3>
              <p style="font-size:13px;color:#555;line-height:1.7">
                Munch Time Cafe<br>
                Bharatpur, Chitwan<br>
                Nepal
              </p>
              <a href="../index.html" style="display:inline-block;margin-top:10px;font-size:13px;color:var(--brand)">View our menu →</a>
            </div>
          </aside>
        </div>

        <footer class="site-footer">
          <p>&copy; <%= new Date().getFullYear() %> <a href="../index.html">Munch Time Cafe</a> · Chitwan, Nepal</p>
        </footer>

  </body>
  </html>
