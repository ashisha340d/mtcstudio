    <div class="header-actions"><button class="cart-btn" onclick="toggleCart()">🛒 My Feast<span class="cart-count"
          id="cartCount">0</span></button></div>
    <div class="nav-actions">
      <button class="nav-toggle" id="navToggleBtn" onclick="toggleMobileMenu()">
        <span></span>
