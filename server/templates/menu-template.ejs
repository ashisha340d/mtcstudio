  <main class="menu-content">
    <%- menuContent %>
  </main>

  <div class="cart-overlay" id="cartOverlay" onclick="toggleCart()"></div>

  <div class="cart-drawer" id="cartDrawer">
    <div class="cart-head">
      <h2>🛒 My Feast</h2>
      <button class="cart-close" onclick="toggleCart()">✕</button>
    </div>
    <div class="cart-items" id="cartItems"></div>
    <div class="cart-foot" id="cartFoot" style="display:none">
      <div class="cart-total">
        <span>Total</span>
        <span class="cart-total-price" id="cartTotal">Rs.0</span>
      </div>
      <button class="whatsapp-btn" onclick="orderWhatsApp()">📲 Order via WhatsApp</button>
      <button class="clear-cart-btn" onclick="clearCart()">Clear cart</button>
    </div>
  </div>

  <div class="modal-overlay" id="confirmModal" onclick="closeConfirmModal()"></div>
  <div class="modal-box" id="confirmBox">
    <div class="modal-content">
      <h3>Confirm Order</h3>
      <p>Enter your details before sending</p>
      <div class="modal-form">
        <div class="form-group">
          <label for="senderName">Your Name</label>
          <input type="text" id="senderName" placeholder="Enter your name" autocomplete="off">
        </div>
        <div class="form-group">
          <label for="orderType">Order Type</label>
          <select id="orderType">
            <option value="">Select option</option>
            <option value="Pickup">Pickup</option>
            <option value="Delivery">Delivery</option>
          </select>
        </div>
      </div>
    </div>
    <div class="modal-actions">
      <button class="modal-btn modal-btn-cancel" onclick="closeConfirmModal()">Cancel</button>
      <button class="modal-btn modal-btn-confirm" onclick="sendOrderNow()">Send Order</button>
    </div>
  </div>

  <iframe allowfullscreen="allowfullscreen" allow="clipboard-write" scrolling="no" class="fp-iframe"
    src="https://heyzine.com/flip-book/290157bac9.html"
    style="border: 1px solid lightgray; width: 100%; height: 370px;"></iframe>

  <footer class="site-footer">
    <p><strong>Munch Time Cafe</strong></p>
    <p>Nepal &nbsp;|&nbsp; <a href="https://munchtimecafe.com.np">munchtimecafe.com.np</a></p>
    <p style="margin-top:8px;font-size:11px;color:#666">Menu last updated: <%= new
        Date().toLocaleDateString('en-NP',{year:'numeric',month:'long',day:'numeric'}) %>
    </p>
  </footer>

  <script>
    // ── CART ─────────────────────────────────────────────────────────────────────
    let cart = JSON.parse(localStorage.getItem('mtc_cart') || '[]');

    function saveCart() {
      localStorage.setItem('mtc_cart', JSON.stringify(cart));
    }

    function addItem(slug, name, price, variant) {
      const key = slug + (variant ? '_' + variant : '');
      const existing = cart.find(i => i.key === key);
      if (existing) {
        existing.qty++;
      } else {
        cart.push({ key, slug, name, price: parseFloat(price) || 0, variant: variant || '', qty: 1 });
      }
      saveCart();
      renderCart();
      showAddFeedback(slug);
    }

    function changeQty(key, delta) {
      const item = cart.find(i => i.key === key);
      if (!item) return;
      item.qty += delta;
      if (item.qty <= 0) cart = cart.filter(i => i.key !== key);
      saveCart();
      renderCart();
    }

    function clearCart() {
      if (!confirm('Clear your entire cart?')) return;
      cart = [];
      saveCart();
      renderCart();
      toggleCart();
    }

    function renderCart() {
      const container = document.getElementById('cartItems');
      const foot = document.getElementById('cartFoot');
      const countEl = document.getElementById('cartCount');
      const totalEl = document.getElementById('cartTotal');

      const totalQty = cart.reduce((s, i) => s + i.qty, 0);
      const totalPrice = cart.reduce((s, i) => s + i.price * i.qty, 0);
      countEl.textContent = totalQty;

      if (!cart.length) {
        container.innerHTML = '<div class="cart-empty"><div style="font-size:36px">🛒</div><p>Your feast is empty!</p></div>';
        foot.style.display = 'none';
        return;
      }

      foot.style.display = 'block';
      totalEl.textContent = 'Rs.' + totalPrice.toFixed(0);
      container.innerHTML = cart.map(item => `
    <div class="cart-item">
      <div class="cart-item-info">
        <div class="cart-item-name">${escHtml(item.name)}</div>
        ${item.variant ? `<div class="cart-item-variant">${escHtml(item.variant)}</div>` : ''}
        <div class="cart-qty">
          <button class="qty-btn" onclick="changeQty('${escHtml(item.key)}',-1)">−</button>
          <span class="qty-val">${item.qty}</span>
          <button class="qty-btn" onclick="changeQty('${escHtml(item.key)}',1)">+</button>
        </div>
      </div>
      <div class="cart-item-price">Rs.${(item.price * item.qty).toFixed(0)}</div>
    </div>`).join('');
    }

    function escHtml(str) {
      return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function toggleCart() {
      const overlay = document.getElementById('cartOverlay');
      const drawer = document.getElementById('cartDrawer');
      const isOpen = drawer.classList.contains('open');
      overlay.classList.toggle('open', !isOpen);
      drawer.classList.toggle('open', !isOpen);
    }

    function orderWhatsApp() {
      if (!cart.length) return;
      openConfirmModal();
    }

    function sendOrderNow() {
      const senderName = document.getElementById('senderName').value.trim();
      const orderType = document.getElementById('orderType').value;

      if (!senderName) {
        alert('Please enter your name');
        return;
      }

      if (!orderType) {
        alert('Please select order type');
        return;
      }

      const today = new Date().toLocaleDateString('en-NP', { year: 'numeric', month: '2-digit', day: '2-digit' });
      const total = cart.reduce((s, i) => s + i.price * i.qty, 0);

      let msg = 'Hi I would like to order from\n';
      msg += 'Munch Time Cafe\n';
      msg += '================================\n';
      msg += `Date                    : ${today}\n`;
      msg += `Sender Name : ${senderName}\n`;
      msg += `Order Type      : ${orderType}\n`;
      msg += '*****************************\n\n';

      // Add items with numbering
      let itemNum = 1;
      cart.forEach(i => {
        const itemTotal = (i.price * i.qty).toFixed(0);
        msg += `${itemNum}. ${i.name}${i.variant ? ' (' + i.variant + ')' : ''} - ${i.qty} x ${i.price} = ${itemTotal}\n`;
        itemNum++;
      });

      msg += '*****************************\n';
      msg += `Total                                              = ${total.toFixed(0)}/-\n`;

      const encodedMsg = encodeURIComponent(msg);
      window.open('https://wa.me/+9779809149388?text=' + encodedMsg, '_blank');

      // Clear cart and close modal
      cart = [];
      saveCart();
      renderCart();
      closeConfirmModal();
      toggleCart();
    }

    function openConfirmModal() {
      const overlay = document.getElementById('confirmModal');
      const box = document.getElementById('confirmBox');
      overlay.classList.add('open');
      box.classList.add('open');
    }

    function closeConfirmModal() {
      const overlay = document.getElementById('confirmModal');
      const box = document.getElementById('confirmBox');
      overlay.classList.remove('open');
      box.classList.remove('open');
      // Clear form fields
      document.getElementById('senderName').value = '';
      document.getElementById('orderType').value = '';
    }

    function showAddFeedback(slug) {
      const card = document.getElementById(slug);
      if (!card) return;
      const btn = card.querySelector('.add-btn, .add-btn-sm');
      if (!btn) return;
      const orig = btn.textContent;
      btn.textContent = '✓ Added!';
      btn.style.background = '#2e7d32';
      setTimeout(() => { btn.textContent = orig; btn.style.background = ''; }, 1000);
    }

    // ── Wire up all Add buttons ──────────────────────────────────────────────────
    document.querySelectorAll('.add-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        addItem(btn.dataset.slug, btn.dataset.name, btn.dataset.price, '');
      });
    });
    document.querySelectorAll('.add-btn-sm').forEach(btn => {
      btn.addEventListener('click', () => {
        addItem(btn.dataset.slug, btn.dataset.name, btn.dataset.price, btn.dataset.variant || '');
      });
    });

    // ── Active nav on scroll ──────────────────────────────────────────────────────
    const navLinks = document.querySelectorAll('.section-nav a');
    const sections = document.querySelectorAll('.menu-section');
    let activeSectionId = '';

    function updateActiveNav() {
      let current = '';
      sections.forEach(sec => {
        if (window.scrollY + 160 >= sec.offsetTop) current = sec.id;
      });

      if (!current || current === activeSectionId) return;
      activeSectionId = current;

      navLinks.forEach(a => {
        const href = a.getAttribute('href').replace('#', '');
        const isActive = href === current;
        a.classList.toggle('active', isActive);

        if (isActive) {
          a.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'center'
          });
        }
      });
    }
    window.addEventListener('scroll', updateActiveNav, { passive: true });
    updateActiveNav();
    // ── Init ─────────────────────────────────────────────────────────────────────
    renderCart();
    function toggleMobileMenu() {
      const menu = document.getElementById('navMenuWrapper');
      const toggleBtn = document.getElementById('navToggleBtn');

      menu.classList.toggle('mobile-open');
      toggleBtn.classList.toggle('open');
    }

  </script>

</body>

